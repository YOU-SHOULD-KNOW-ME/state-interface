{
  "name": "state-interface",
  "version": "0.1.0",
  "description": "A character-independent canvas interface for agent activity states",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js",
    "./adapters": "./src/adapters.js"
  },
  "files": [
    "src",
    "assets",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "ASSETS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "python3 -m http.server 8080 --bind 127.0.0.1"
  },
  "keywords": [
    "claude",
    "pixel-art",
    "animation",
    "companion",
    "state-interface"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://YOU-SHOULD-KNOW-ME.github.io/state-interface/",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOU-SHOULD-KNOW-ME/state-interface.git"
  },
  "bugs": {
    "url": "https://github.com/YOU-SHOULD-KNOW-ME/state-interface/issues"
  }
}
